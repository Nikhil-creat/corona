# ───────── Core ─────────
ENV=dev                         # dev | prod  (dev enables /api/dev/* helpers)
USE_IN_MEMORY=false             # true = no Kafka/Redis/Postgres/Neo4j (single-process demo + tests)
EMBEDDED_WORKER=false           # true = run the swarm worker inside the API process

# ───────── Messaging / state ─────────
KAFKA_BOOTSTRAP=redpanda:9092
REDIS_URL=redis://redis:6379/0
REDIS_CLUSTER=false             # true when REDIS_URL points at a Redis Cluster

# ───────── Knowledge fabric ─────────
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=aether
POSTGRES_DSN=postgresql://aether:change-me-postgres@postgres:5432/aether
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
EMBEDDING_BACKEND=hashing       # hashing | sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANK_BACKEND=lexical          # lexical | cross-encoder
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MIN_EVIDENCE_SCORE=0.15         # below this, agents ABSTAIN and escalate (zero-hallucination gate)

# ───────── API security ─────────
API_KEYS=change-me-api-key                  # comma separated
CORS_ORIGINS=http://localhost:3000
APPROVAL_MODE=token                          # token | ed25519
APPROVER_TOKENS=ops-lead:change-me-approver-token   # name:token,name:token  (token mode)
APPROVER_PUBKEYS=                            # name:<ed25519 public key hex>  (ed25519 mode)
APPROVAL_HMAC_SECRET=change-me-hmac-secret-32-bytes-min
APPROVAL_TTL_S=900
HITL_RISK_THRESHOLD=0.6
PQ_REQUIRED=false                            # true = refuse to start without a real ML-KEM backend (liboqs)

# ───────── Vision / edge ─────────
VISION_BACKEND=simulated        # simulated | torch
VISION_WEIGHTS=/models/hybrid_spatialnet.pt
RTSP_URLS=                      # comma separated node_id=rtsp://... (torch backend)
EDGE_TICK_HZ=2

# ───────── Observability ─────────
OTEL_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ───────── Frontend (build-time) ─────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_API_KEY=change-me-api-key
